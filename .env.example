# Postgres. Any instance works: Supabase, Neon, or your own.
# Leave unset in development to use the embedded Postgres in .pgdata.
# Supabase: use the connection pooler on port 6543, not the direct host, which
# is IPv6 only. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Dodo Payments. Create a one-time product with Pay What You Want enabled and
# put its id here. The server sets the amount per checkout, so the buyer never
# picks their own price.
DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
DODO_MODE=test

# Salts visitor hashes for click dedupe and presence. Any random string.
HASH_SALT=change-me

# Gates /api/seed
ADMIN_TOKEN=change-me

NEXT_PUBLIC_SITE_NAME=coolapp
